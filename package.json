{
  "name": "station",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "predev": "node scripts/copy-zxing.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-zxing.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "pretest:e2e": "node scripts/copy-zxing.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:int",
    "check:bundle": "next build && node --env-file-if-exists=.env.local scripts/check-bundle.mjs",
    "db:reset": "supabase db reset",
    "clean:dev": "rm -rf .mail .seed",
    "db:types": "supabase gen types typescript --local > lib/db/types.gen.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "gen:qr-video": "tsx --env-file-if-exists=.env.local scripts/gen-qr-video.ts",
    "event:create": "tsx --env-file-if-exists=.env.local scripts/create-event.ts",
    "load-test": "tsx --env-file=.env.test scripts/load-test.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "barcode-detector": "~3.2.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "motion": "12.23.24",
    "next": "^16.4.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "jsqr": "^1.4.0",
    "pg": "^8.23.0",
    "tailwindcss": "4.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
