# SPEC §19. Copy to .env.local for `pnpm dev`. Values below target the local Supabase stack;
# run `supabase status -o env` to get the local keys.

NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# L1: scheduler credential (Vercel Cron sends `Authorization: Bearer $CRON_SECRET`
# automatically) and mail-drain credential are separate secrets.
# >= 32 random bytes each: `openssl rand -hex 32`
SHEET_INGEST_SECRET=
CRON_SECRET=
EMAIL_DRAIN_SECRET=
# Deprecated: when set, backs both of the above until they are set (then remove it).
# DRAIN_SECRET=
# Pass tokens are derived from this (SPEC §6.1), so /me can show a pass again. Changing it hides older passes on /me.
PASS_TOKEN_SECRET=
# Optional, comma-separated: these accounts are organizer on every event (SPEC F9). Keep the list short.
ADMIN_EMAILS=

# Only needed for "Sync now" (S3). Read-only Sheets scope.
GOOGLE_SERVICE_ACCOUNT_JSON=

# console | resend. Tests MUST use console. Dev defaults to console; resend is opt-in (real sends, own addresses only).
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=

# Optional (SPEC §6.5): origin written onto NFC badge tags, e.g. https://nfc.yvesdonato.com.
# Defaults to NEXT_PUBLIC_APP_ORIGIN; the tag writer only writes https:// origins.
BADGE_ORIGIN=

# Optional, local dev only: your stable tunnel host (README "A tunnel URL that never changes"), e.g.
# brownsons-macbook-air.tail1234.ts.net. Lets your phone open pass pages through the tunnel.
DEV_PUBLIC_HOST=

# Test-only (not read by the app). Integration tests refuse any non-local host.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
